{
    "name": "visavi/rzd-api",
    "description": "Клиент API РЖД: поиск поездов, вагоны и места, маршруты, цены",
    "keywords": ["rzd", "api", "train", "ticket", "railway"],
    "homepage": "https://visavi.net",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Grigorev",
            "email": "admin@visavi.net",
            "homepage": "https://visavi.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.0",
        "guzzlehttp/psr7": "^3.0",
        "php-http/mock-client": "^1.6",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Реализация PSR-18, если в проекте ещё нет своего HTTP-клиента"
    },
    "autoload": {
        "psr-4": {
            "Rzd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rzd\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:live": "phpunit --group live",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
